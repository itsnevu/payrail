# One deployer key for every network. Never a key that holds real funds you cannot lose.
DEPLOYER_PRIVATE_KEY=0x...

# ── Arc ────────────────────────────────────────────────────────────────
# chainId and RPC are PLACEHOLDERS. Verify against the official Arc / Circle docs.
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042
# Official USDC on Arc Testnet. MUST be verified against the Circle/Arc documentation.
USDC_ADDRESS_ARCTESTNET=0x...
# Mainnet: no defaults. Fill in ONLY after verifying against official Arc/Circle docs.
ARC_MAINNET_RPC_URL=
ARC_MAINNET_CHAIN_ID=
USDC_ADDRESS_ARCMAINNET=
# Explorer API key for `npx hardhat verify` on Arc
EXPLORER_API_KEY=

# ── Robinhood Chain (Arbitrum Orbit, ETH gas) ──────────────────────────
# Mainnet chain 4663, testnet 46630. Deployer needs a little ETH on that chain for gas.
# On an ISP that filters rpc.mainnet.chain.robinhood.com, run launchpad's `npm run rpc:proxy`
# and set ROBINHOOD_RPC_URL=http://127.0.0.1:8545 (stop the hardhat node first: same port).
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
# The bridged USDC contract on Robinhood Chain. Not recorded anywhere in this repo yet:
# take it from the official Robinhood Chain bridge / Blockscout token list, confirm it has
# 6 decimals, then paste it here. deploy.ts refuses to run without it.
USDC_ADDRESS_ROBINHOODMAINNET=
USDC_ADDRESS_ROBINHOODTESTNET=
# Blockscout accepts any non-empty key for verification; leave unset to use "blockscout".
BLOCKSCOUT_API_KEY=

# Legacy single-chain fallback, used when USDC_ADDRESS_<NETWORK> is unset.
USDC_ADDRESS=
