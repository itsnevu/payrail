# One deployer key for every network. Never a key that holds real funds you cannot lose.
DEPLOYER_PRIVATE_KEY=0x...

# ── Robinhood Chain (Arbitrum Orbit, ETH gas) ──────────────────────────
# Mainnet chain 4663, testnet 46630. The deployer needs a little ETH on that chain for gas
# (a deploy costs ~0.00003 ETH). `npm run go:robinhood` handles RPC filtering, the token
# lookup, the deploy and Blockscout verification; only this key is required.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Billing token. Leave empty to use USDG 0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168 (Global Dollar, 6 decimals),
# the dollar stablecoin on Robinhood Chain. Set a USDC contract here to bill in USDC instead.
USDC_ADDRESS_ROBINHOODMAINNET=
USDC_ADDRESS_ROBINHOODTESTNET=
# Blockscout accepts any non-empty key for verification; leave unset to use "blockscout".
BLOCKSCOUT_API_KEY=

# Legacy single-chain fallback, used when USDC_ADDRESS_<NETWORK> is unset.
USDC_ADDRESS=
