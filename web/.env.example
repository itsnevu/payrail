# Database (SQLite by default; for Postgres: postgresql://user:pass@localhost:5432/payrail)
DATABASE_URL="file:./dev.db"

# Chain. Local hardhat: chainId 31337, RPC http://127.0.0.1:8545
# Arc Testnet: VERIFY chainId and RPC against the official Arc/Circle docs.
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_EXPLORER_URL=

# Filled automatically by contracts/scripts/deploy.ts into src/lib/deployment.json,
# but can be overridden here.
NEXT_PUBLIC_PAYMENT_PROCESSOR_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=

# Block confirmations required before an invoice is considered PAID
CONFIRMATIONS=1

# Simple shared secret protecting the indexer endpoint (cron)
INDEXER_SECRET=change-me

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web Push ("Invoice paid" notifications). Generate once: npx web-push generate-vapid-keys
# Leave empty to disable; the app runs unchanged without them.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@payrail.app

# WalletConnect project id (https://cloud.reown.com) so buyers can pay from a mobile wallet.
# Leave empty to offer only injected (browser extension) wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
