# Database (SQLite by default; for Postgres: postgresql://user:pass@localhost:5432/payrail)
DATABASE_URL="file:./dev.db"

# ── Chains ──────────────────────────────────────────────────────────────
# Payrail is multi-chain: every invoice is pinned to one network at creation.
# Known ids: 31337 hardhat · 5042 Arc Testnet (placeholder id) · 4663 Robinhood Chain ·
# 46630 Robinhood Chain Testnet. See src/lib/chains.ts.
#
# Which networks the app offers. Leave empty to enable every chain that has a deployment in
# src/lib/deployments.json (written by contracts/scripts/deploy.ts). Order = display order.
NEXT_PUBLIC_CHAINS=
# Preselected network for new invoices. Empty = first enabled chain.
NEXT_PUBLIC_DEFAULT_CHAIN_ID=

# Server-side RPC per chain (verify, indexer, /api/rpc relay). Unset = public endpoint.
RPC_URL_31337=http://127.0.0.1:8545
RPC_URL_5042=
# Robinhood Chain. On an Indonesian ISP rpc.mainnet.chain.robinhood.com resolves to a filter
# page: for local dev run launchpad's `npm run rpc:proxy` and set http://127.0.0.1:8545 here
# (stop the hardhat node first, same port). On the VPS the public endpoint works.
RPC_URL_4663=
RPC_URL_46630=

# Browser-side RPC per chain (wagmi + wallet). Unset = public endpoint, except Robinhood
# Chain which defaults to the same-origin relay /api/rpc/<chainId> (needed on filtered ISPs).
NEXT_PUBLIC_RPC_URL_31337=
NEXT_PUBLIC_RPC_URL_5042=
NEXT_PUBLIC_RPC_URL_4663=
NEXT_PUBLIC_RPC_URL_46630=

# Explorer base URL per chain (tx links). Robinhood defaults to Blockscout; Arc has none yet.
NEXT_PUBLIC_EXPLORER_URL_5042=
NEXT_PUBLIC_EXPLORER_URL_4663=
NEXT_PUBLIC_EXPLORER_URL_46630=

# Contract addresses per chain. Filled automatically by contracts/scripts/deploy.ts into
# src/lib/deployments.json; set these only to override that file.
NEXT_PUBLIC_PAYMENT_PROCESSOR_ADDRESS_5042=
NEXT_PUBLIC_USDC_ADDRESS_5042=
NEXT_PUBLIC_PAYMENT_PROCESSOR_ADDRESS_4663=
NEXT_PUBLIC_USDC_ADDRESS_4663=
NEXT_PUBLIC_PAYMENT_PROCESSOR_ADDRESS_46630=
NEXT_PUBLIC_USDC_ADDRESS_46630=

# Block confirmations required before an invoice is PAID. Global default, per-chain override.
CONFIRMATIONS=1
CONFIRMATIONS_4663=2

# /api/rpc relay: requests per second per IP, and burst size.
RPC_RELAY_RATE=20
RPC_RELAY_BURST=60

# Simple shared secret protecting the indexer endpoint (cron)
INDEXER_SECRET=change-me

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web Push ("Invoice paid" notifications). Generate once: npx web-push generate-vapid-keys
# Leave empty to disable; the app runs unchanged without them.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@payrail.app

# WalletConnect project id (https://cloud.reown.com) so buyers can pay from a mobile wallet.
# Leave empty to offer only injected (browser extension) wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
