// Default: SQLite so it runs with no setup.
// For PostgreSQL switch provider = "postgresql" and DATABASE_URL in .env.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Merchant {
  id            String    @id @default(cuid())
  name          String
  walletAddress String    @unique
  createdAt     DateTime  @default(now())
  invoices      Invoice[]
}

model Invoice {
  id           String        @id @default(cuid())
  // bytes32 = keccak256(abi.encode(keccak256(id), merchant, amount)), used by the contract
  onchainId    String        @unique
  // Network this invoice must be paid on (31337 hardhat, 4663 Robinhood Chain,
  // 46630 Robinhood Chain Testnet). See web/src/lib/chains.ts.
  // The default keeps rows created before dual-chain support valid (all were local).
  chainId      Int           @default(31337)
  merchantId   String
  merchant     Merchant      @relation(fields: [merchantId], references: [id])
  customerName String?
  description  String
  // Amount in smallest USDC units (6 decimals), stored as a string for precision
  amount       String
  // PENDING | PAID | EXPIRED | CANCELLED (string because SQLite has no enums)
  status       String        @default("PENDING")
  dueAt        DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  payment      Payment?

  @@index([chainId, status])
}

model Payment {
  id          String   @id @default(cuid())
  invoiceId   String   @unique
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  chainId     Int      @default(31337)
  txHash      String   @unique
  payer       String
  amount      String
  blockNumber BigInt
  paidAt      DateTime
  createdAt   DateTime @default(now())
}

// Last block the indexer has scanned, one cursor per chain (keyed by chainId)
model IndexerState {
  chainId   Int    @id
  lastBlock BigInt
}

// Web Push subscriptions, one row per browser/device. Keyed by merchant so a
// "paid" notification goes to whoever owns the invoice.
model PushSubscription {
  id         String   @id @default(cuid())
  merchantId String
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
}
